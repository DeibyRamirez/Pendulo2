NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

NEXT_PUBLIC_APP_URL=

# Cámara en vivo. Guía: docs/camara-en-vivo.md
# Local: túnel PuTTY (L8090 → 10.10.161.61:8080).
# Vercel: túnel named Cloudflare (NO Custom Domain del proyecto).
# NEXT_PUBLIC_CAMARA_PROTOCOLO=mjpeg
# NEXT_PUBLIC_CAMARA_URL=https://camarapendulo.cheiviz.com/?action=stream
# WebRTC opcional (MediaMTX/WHEP; no uses playit.gg ni UDP en el <img>):
# NEXT_PUBLIC_CAMARA_PROTOCOLO=webrtc
# NEXT_PUBLIC_CAMARA_URL=https://camarapendulo.cheiviz.com/cam
NEXT_PUBLIC_CAMARA_PROTOCOLO=mjpeg
# En local (PuTTY): http://localhost:8090/?action=stream
# En Vercel / Production: usa el MJPEG, NO stream.html
NEXT_PUBLIC_CAMARA_URL=https://camarapendulo.cheiviz.com/?action=stream
GOOGLE_AI_API_KEY=

VERTEX_PROJECT_ID=
VERTEX_LOCATION=        

GOOGLE_SERVICE_ACCOUNT_JSON=

# ─────────────────────────────────────────────────────────────────────────
# NOTA: las credenciales MQTT (broker Mosquitto en la Raspberry Pi) y la
# cuenta de servicio de Firebase Admin usadas para el puente MQTT<->Firestore
# NO van aquí. Esta web (Next.js/Vercel) solo lee Firestore con el SDK de
# cliente (onSnapshot), nunca habla MQTT directamente.
# Ver bridge/.env.example para la configuración del proceso que corre en la
# Raspberry Pi.
# ─────────────────────────────────────────────────────────────────────────
